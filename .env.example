# --- Server ---
HOST=0.0.0.0
PORT=3000
# Comma-separated allowed origin hosts for the proxy (empty = allow all except private IPs)
ALLOWED_HOSTS=
# Protocol allowlist
ALLOWED_PROTOCOLS=http,https

# --- Outbound ---
# Timeouts in ms
UPSTREAM_CONNECT_TIMEOUT=10000
UPSTREAM_REQUEST_TIMEOUT=60000
# Max response body we will buffer for rewriting (bytes); larger stream untouched
MAX_REWRITE_BODY_BYTES=5242880
# Keep-alive connections per origin
KEEP_ALIVE_MAX=64
# Upstream IP family: auto (default) | ipv4 | ipv6. Set ipv4 if outbound IPv6 is broken
UPSTREAM_IP_FAMILY=auto

# --- Cache (multi-node) ---
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=300

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Proxy URL scheme ---
# Public origin the proxy is served at, e.g. https://proxy.example
PROXY_PUBLIC_ORIGIN=http://localhost:3000
